generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Image {
  id            String @id @default(uuid())
  imageUrl      String
  cloudinaryId  String
  caption       String
  metaData      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
